# Next.js frontend environment variables
#
# Provide these via the orchestrator/platform. Do not commit real secrets.

# Base URL of task_backend REST API (no trailing slash)
# Preview backend currently runs on port 3001.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# WebSocket base URL of task_backend (no trailing slash)
# Example: ws://localhost:3001
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:3001
